    <Macros>
      <pythonCode type="QString">from qgis.core import QgsProject, QgsMessageLog, Qgis&#xd;
from functools import partial&#xd;
&#xd;
&#xd;
def update_geom_modified(fid, layer):&#xd;
    idx = layer.fields().indexOf("geom_modified")&#xd;
    layer.changeAttributeValue(fid, idx, 1)&#xd;
    print(f"update_geom_modified registered for feature {fid} in Layer {layer.name()}")&#xd;
    QgsMessageLog.logMessage(&#xd;
        f"geom_modified registered for feature {fid} in Layer {layer.name()}",&#xd;
        "SAC Route-Network-Editor",&#xd;
        Qgis.Info,&#xd;
    )&#xd;
&#xd;
&#xd;
def openProject():
    routes_layer = QgsProject.instance().mapLayersByName("Routes")[0]&#xd;
    routes_geom_update_listener = partial(update_geom_modified, layer=routes_layer)&#xd;
    routes_layer.geometryChanged.connect(routes_geom_update_listener)&#xd;


def saveProject():
    pass

def closeProject():
    pass
</pythonCode>
